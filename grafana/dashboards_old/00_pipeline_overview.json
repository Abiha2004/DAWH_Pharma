          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT refresh_id AS \"Refresh\", refresh_month AS \"Month\", to_char(started_at, 'DD Mon HH24:MI:SS') AS \"Started\",\n       round(extract(epoch FROM finished_at - started_at)::numeric, 0) AS \"Duration (s)\", status AS \"Status\"\nFROM ops.refresh_log ORDER BY started_at"
