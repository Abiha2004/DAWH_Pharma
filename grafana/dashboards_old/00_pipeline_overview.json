          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "#2E7D32",
                        "index": 0,
                        "text": "✔ SUCCESS"
                      },
                      "SKIPPED_DUPLICATE": {
                        "color": "#2E75B6",
                        "index": 1,
                        "text": "↺ SKIPPED (duplicate)"
                      },
                      "RUNNING": {
                        "color": "#EF6C00",
                        "index": 2,
                        "text": "⟳ RUNNING"
                      },
                      "FAILED": {
                        "color": "#C62828",
                        "index": 3,
                        "text": "✖ FAILED"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
