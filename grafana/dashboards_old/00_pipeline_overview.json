          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE layer WHEN 'bronze' THEN '1 Bronze  raw' WHEN 'silver' THEN '2 Silver  staging' WHEN 'gold' THEN '3 Gold  dwh'\n                  WHEN 'mart' THEN '4 Mart  materialized views' ELSE '5 Quarantine' END AS layer, sum(row_count) AS rows\nFROM (SELECT DISTINCT ON (schema_name, table_name) * FROM ops.storage_snapshot\n             ORDER BY schema_name, table_name, captured_at DESC) s GROUP BY 1 ORDER BY 1"
        }
