          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN reason LIKE 'missing_field:%' THEN 'Missing field: ' || split_part(reason, ':', 2)\n            WHEN reason LIKE 'null_key:%'      THEN 'Empty key: ' || split_part(reason, ':', 2)\n            WHEN reason LIKE 'not_a_json%'     THEN 'Not a JSON object'\n            ELSE 'Invalid / truncated JSON' END AS reason,\n       count(*) AS events\nFROM ops.stream_dead_letter WHERE refresh_id IN ($refresh) GROUP BY 1 ORDER BY 2 DESC"
        }
