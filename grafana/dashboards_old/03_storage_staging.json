          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT refresh_id,\n       sum(row_count) FILTER (WHERE layer = 'bronze') AS \"bronze\",\n       sum(row_count) FILTER (WHERE layer = 'silver') AS \"silver\",\n       sum(row_count) FILTER (WHERE layer = 'gold' AND table_name LIKE 'fact%') AS \"gold facts\"\nFROM (SELECT DISTINCT ON (refresh_id, table_name) * FROM ops.storage_snapshot ORDER BY refresh_id, table_name, captured_at DESC) x\nGROUP BY refresh_id ORDER BY 1"
