    {
      "id": 23,
      "type": "stat",
      "title": "Last completed refresh",
      "description": "Most recent refresh that finished end-to-end",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-dwh"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
