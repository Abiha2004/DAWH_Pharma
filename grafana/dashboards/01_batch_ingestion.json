        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^label$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-dwh"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT refresh_id || '  ·  ' || COALESCE(refresh_month, '') || '  ·  ' || to_char(finished_at, 'DD Mon HH24:MI') AS label FROM ops.refresh_log WHERE status = 'SUCCESS' ORDER BY finished_at DESC LIMIT 1"
        }
