          "rawSql": "SELECT w.warehouse_name AS warehouse, sum(f.closing_qty) AS stock_on_hand\nFROM dwh.fact_inventory_snapshot f JOIN dwh.dim_warehouse w USING (warehouse_key)\nWHERE f.snapshot_date_key = (SELECT max(snapshot_date_key) FROM dwh.fact_inventory_snapshot)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    },
