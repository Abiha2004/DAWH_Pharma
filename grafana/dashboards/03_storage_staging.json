      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-dwh"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH inv AS (\n    SELECT f.warehouse_key, count(*) AS snapshot_rows, round(avg(f.available_qty)) AS avg_available,\n           sum(f.stockout_flag) AS stockout_lot_days, sum(f.near_expiry_flag) AS near_expiry_lot_days,\n           round(100 * avg(f.fefo_compliance_flag), 1) AS fefo_pct, sum(f.expired_qty) AS expired_packs\n    FROM dwh.fact_inventory_snapshot f GROUP BY 1\n), cur AS (\n    SELECT warehouse_key, sum(closing_qty) AS stock_on_hand FROM dwh.fact_inventory_snapshot\n    WHERE snapshot_date_key = (SELECT max(snapshot_date_key) FROM dwh.fact_inventory_snapshot) GROUP BY 1\n), sal AS (\n    SELECT warehouse_key, sum(quantity_sold_packs) AS units_sold FROM dwh.fact_pharmacy_sales GROUP BY 1\n)\nSELECT w.warehouse_name AS \"Warehouse\", w.region AS \"Region\",\n       CASE WHEN w.cold_chain_capable THEN '❄ 2-8 °C' ELSE 'Ambient' END AS \"Storage\",\n       cur.stock_on_hand AS \"Stock on hand (packs)\", inv.avg_available AS \"Avg available / lot\",\n       sal.units_sold AS \"Units sold from DC\", inv.snapshot_rows AS \"Snapshot rows\",\n       inv.stockout_lot_days AS \"Stockout lot-days\", inv.near_expiry_lot_days AS \"Near-expiry lot-days\",\n       inv.expired_packs AS \"Expired packs\", inv.fefo_pct AS \"FEFO compliance %\"\nFROM dwh.dim_warehouse w JOIN inv USING (warehouse_key) LEFT JOIN cur USING (warehouse_key) LEFT JOIN sal USING (warehouse_key)\nWHERE w.warehouse_key > 0 ORDER BY \"Stock on hand (packs)\" DESC NULLS LAST"
        }
      ]
    },
